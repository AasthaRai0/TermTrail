DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=termtrail_db
DB_USER=root
DB_PASS=
APP_URL=http://localhost/termtrail
APP_ENV=development

# --- AI (optional). Leave blank to use basic extraction only.
# Get a key at https://aistudio.google.com/apikey  (the key stays on the server)
GEMINI_API_KEY=
# Blank = built-in default (gemini-2.0-flash). Set a model name from Google AI Studio if that one is unavailable.
GEMINI_MODEL=
# Semantic search for Copilot is OFF unless this is set (it can be the same key as GEMINI_API_KEY).
EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=

# --- Email reminders (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM=
