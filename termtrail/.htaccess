Options -Indexes
<FilesMatch "^(\.env|composer\.(json|lock)|phpunit\.xml|README\.md|\.env\.(example|testing))$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^/termtrail/(storage|backend/(config|models|services|helpers|middleware|controllers)|frontend/(pages|components)|database|cron|tests|tools|vendor)/
