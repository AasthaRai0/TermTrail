{
  "name": "termtrail/termtrail-ai",
  "description": "TermTrail AI - Contract Intelligence & Lifecycle Management",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "smalot/pdfparser": "^2.9",
    "dompdf/dompdf": "^2.0",
    "phpmailer/phpmailer": "^6.9",
    "jfcherng/php-diff": "^6.16"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5"
  },
  "autoload": {
    "psr-4": {
      "TermTrail\\": "backend/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  },
  "autoload-dev": {
    "psr-4": {
      "TermTrail\\Tests\\": "tests/"
    }
  }
}